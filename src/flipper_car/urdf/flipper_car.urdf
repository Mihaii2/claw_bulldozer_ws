<?xml version="1.0"?>
<robot name="flipper_car">

  <!-- Base Link / Chassis -->
  <link name="base_link">
    <inertial>
      <mass value="0.6"/>
      <!-- CoM centered -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0025"/>
    </inertial>
    
    <!-- Main Body Box: Trimmed length (0.11m) so 0.045m radius wheels protrude on both ends -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.09 0.028"/>
      </geometry>
      <material name="blue_mat"><color rgba="0.1 0.3 0.8 1.0"/></material>
    </visual>

    <!-- Visual Front Indicator (Yellow) -->
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.08 0.029"/>
      </geometry>
      <material name="bright_yellow"><color rgba="1.0 0.9 0.0 1.0"/></material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.09 0.028"/>
      </geometry>
    </collision>
  </link>

  <!-- 1. Front Left Wheel -->
  <link name="front_left_wheel">
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
      <material name="orange_mat"><color rgba="1.0 0.4 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
    </collision>
  </link>
  <joint name="front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.055 0.062 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 2. Rear Left Wheel -->
  <link name="rear_left_wheel">
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
      <material name="black_mat"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.055 0.062 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 3. Front Right Wheel -->
  <link name="front_right_wheel">
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
      <material name="orange_mat"><color rgba="1.0 0.4 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
    </collision>
  </link>
  <joint name="front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.055 -0.062 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 4. Rear Right Wheel -->
  <link name="rear_right_wheel">
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
      <material name="black_mat"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.022"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.055 -0.062 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Gazebo Material Colors -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.1 0.3 0.8 1.0</ambient>
      <diffuse>0.1 0.3 0.8 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="front_left_wheel">
    <material><ambient>1.0 0.4 0.0 1.0</ambient><diffuse>1.0 0.4 0.0 1.0</diffuse></material>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <material><ambient>1.0 0.4 0.0 1.0</ambient><diffuse>1.0 0.4 0.0 1.0</diffuse></material>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
  </gazebo>

  <!-- High Grip Friction on Rubber Tires -->
  <gazebo reference="front_left_wheel"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>

  <!-- Diff Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.124</wheel_separation>
      <wheel_radius>0.045</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>front_left_joint</joint_name>
      <joint_name>rear_left_joint</joint_name>
      <joint_name>front_right_joint</joint_name>
      <joint_name>rear_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- IMU Sensor: Pitch reading for balancing -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>/imu</topic>
    </sensor>
  </gazebo>

</robot>